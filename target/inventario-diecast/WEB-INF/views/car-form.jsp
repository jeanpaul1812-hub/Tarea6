<%@ page contentType="text/html; charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><title>${empty car ? 'Nuevo auto' : 'Editar auto'} | Diecast</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/style.css"></head><body><header class="topbar"><div><span class="eyebrow">Inventario</span><h1>${empty car ? 'Registrar auto' : 'Editar auto'}</h1></div><a class="button ghost" href="${pageContext.request.contextPath}/autos">Volver</a></header><main class="container narrow"><form class="form-card" method="post" action="${pageContext.request.contextPath}/autos"><input type="hidden" name="id" value="${car.id}"><div class="form-grid"><label>Marca<input name="marca" value="${car.marca}" required></label><label>Modelo<input name="modelo" value="${car.modelo}" required></label><label>Código<input name="codigo" value="${car.codigo}" required></label><label>Año<input type="number" name="anio" value="${car.anio}" min="1900" max="2100" required></label><label>Número<input type="number" name="numero" value="${car.numero}" min="0"></label><label>Color<input name="color" value="${car.color}"></label><label>Serie<input name="serie" value="${car.serie}"></label><label>Otro<input name="otro" value="${car.otro}"></label><label>T-Hunt<input name="thunt" value="${car.thunt}"></label></div><button class="button primary" type="submit">Guardar auto</button></form></main></body></html>
