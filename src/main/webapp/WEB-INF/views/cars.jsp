<%@ page contentType="text/html; charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html>
<html lang="es">
<head><meta charset="UTF-8"><title>Inventario | Diecast</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/style.css"><style>.search-bar{display:flex;gap:8px;margin-bottom:24px}.search-bar input{flex:1;margin:0}.selection-actions{display:flex;gap:8px;align-items:center}.selection-actions .disabled{opacity:.45;pointer-events:none}.select-cell{text-align:center}.selection-actions button:disabled{opacity:.45;cursor:not-allowed}.sort-link{color:inherit;text-decoration:none;white-space:nowrap}.sort-link:hover{text-decoration:underline}.brand-strip{display:flex;gap:12px;flex-wrap:wrap;padding:18px max(24px,calc((100% - 1180px)/2));background:#172126;border-bottom:4px solid #e15b3e}.brand-logo{display:flex;align-items:center;justify-content:center;min-height:64px;min-width:150px;padding:8px 18px;background:#fff;color:#172126;font-weight:700;letter-spacing:.4px;box-shadow:4px 4px 0 rgba(0,0,0,.2)}.brand-logo img{display:block;width:124px;height:48px;object-fit:contain;background:#fff}.brand-fallback{display:none}.brand-hotwheels{background:#e62922}.brand-matchbox{background:#f4c542}.brand-m2{background:#dce9ec}.brand-majorette{background:#1e6cc7}.brand-greenlight{background:#e9f1e7}@media(max-width:700px){.search-bar,.toolbar{align-items:stretch;flex-direction:column}.selection-actions{flex-wrap:wrap}.brand-strip{gap:8px}.brand-logo{flex:1 1 42%;min-width:0;padding:8px 10px}.brand-logo img{width:100%;max-width:124px}}</style></head>
<body><header class="topbar"><div><span class="eyebrow">Colección</span><h1>Inventario de autos</h1></div><div class="top-actions"><span class="user">${sessionScope.usuario.usuario}</span><c:if test="${esAdministrador}"><a class="button ghost" href="${pageContext.request.contextPath}/usuarios">Administrar usuarios</a></c:if><a class="button ghost" href="${pageContext.request.contextPath}/logout">Salir</a></div></header><nav class="brand-strip" aria-label="Marcas de la colección"><span class="brand-logo brand-hotwheels"><img src="${pageContext.request.contextPath}/assets/images/hotweels.jpg" alt="Logo Hotwheels" loading="eager"/><span class="brand-fallback">Hotwheels</span></span><span class="brand-logo brand-matchbox"><img src="${pageContext.request.contextPath}/assets/images/Matchbox.jpg" alt="Logo matchbox" loading="eager"/><span class="brand-fallback">matchbox</span></span><span class="brand-logo brand-m2"><img src="https://www.google.com/s2/favicons?domain=m2machines.com&amp;sz=128" alt="Logo M2 Machines" loading="eager" onerror="this.style.display='none';this.nextElementSibling.style.display='inline'"/><span class="brand-fallback">M2 Machines</span></span><span class="brand-logo brand-majorette"><img src="https://www.google.com/s2/favicons?domain=majorette.com&amp;sz=128" alt="Logo Majorette" loading="eager" onerror="this.style.display='none';this.nextElementSibling.style.display='inline'"/><span class="brand-fallback">Majorette</span></span><span class="brand-logo brand-greenlight"><img src="https://www.google.com/s2/favicons?domain=greenlighttoys.com&amp;sz=128" alt="Logo GreenLight" loading="eager" onerror="this.style.display='none';this.nextElementSibling.style.display='inline'"/><span class="brand-fallback">GreenLight</span></span></nav>
<main class="container"><form class="search-bar" method="get" action="${pageContext.request.contextPath}/autos"><input type="search" name="q" value="${search}" placeholder="Buscar por marca, modelo, código, año, color o cualquier dato" aria-label="Buscar piezas"><input type="hidden" name="sort" value="${sort}"><input type="hidden" name="dir" value="${dir}"><button class="button primary" type="submit">Buscar</button><c:if test="${not empty search}"><a class="button ghost" href="${pageContext.request.contextPath}/autos">Limpiar</a></c:if></form><div class="toolbar"><p class="muted">${total} piezas registradas | Página ${page} de ${totalPages}</p><c:if test="${esAdministrador}"><div class="selection-actions"><a class="button primary" href="${pageContext.request.contextPath}/autos?action=new">+ Nuevo auto</a><a id="edit-action" class="button ghost disabled" aria-disabled="true" tabindex="-1">Editar</a><button id="delete-action" class="button ghost" type="button" disabled>Eliminar</button></div></c:if></div>
<div class="table-wrap"><table><thead><tr><c:if test="${esAdministrador}"><th>Seleccionar</th></c:if><th><a class="sort-link" href="${pageContext.request.contextPath}/autos?sort=marca&amp;dir=${sort eq 'marca' and dir eq 'asc' ? 'desc' : 'asc'}&amp;q=${search}">Marca</a></th><th><a class="sort-link" href="${pageContext.request.contextPath}/autos?sort=modelo&amp;dir=${sort eq 'modelo' and dir eq 'asc' ? 'desc' : 'asc'}&amp;q=${search}">Modelo</a></th><th><a class="sort-link" href="${pageContext.request.contextPath}/autos?sort=codigo&amp;dir=${sort eq 'codigo' and dir eq 'asc' ? 'desc' : 'asc'}&amp;q=${search}">Código</a></th><th><a class="sort-link" href="${pageContext.request.contextPath}/autos?sort=anio&amp;dir=${sort eq 'anio' and dir eq 'asc' ? 'desc' : 'asc'}&amp;q=${search}">Año</a></th><th><a class="sort-link" href="${pageContext.request.contextPath}/autos?sort=numero&amp;dir=${sort eq 'numero' and dir eq 'asc' ? 'desc' : 'asc'}&amp;q=${search}">Número</a></th><th><a class="sort-link" href="${pageContext.request.contextPath}/autos?sort=color&amp;dir=${sort eq 'color' and dir eq 'asc' ? 'desc' : 'asc'}&amp;q=${search}">Color</a></th><th><a class="sort-link" href="${pageContext.request.contextPath}/autos?sort=serie&amp;dir=${sort eq 'serie' and dir eq 'asc' ? 'desc' : 'asc'}&amp;q=${search}">Serie</a></th><th><a class="sort-link" href="${pageContext.request.contextPath}/autos?sort=thunt&amp;dir=${sort eq 'thunt' and dir eq 'asc' ? 'desc' : 'asc'}&amp;q=${search}">T-Hunt</a></th></tr></thead><tbody>
<c:forEach var="car" items="${cars}"><tr><c:if test="${esAdministrador}"><td class="select-cell"><input type="radio" name="selected-car" value="${car.id}" aria-label="Seleccionar ${car.marca} ${car.modelo}"></td></c:if><td><strong>${car.marca}</strong></td><td>${car.modelo}</td><td>${car.codigo}</td><td>${car.anio}</td><td>${car.numero}</td><td>${car.color}</td><td>${car.serie}</td><td>${car.thunt}</td></tr></c:forEach>
<c:if test="${empty cars}"><tr><td colspan="${esAdministrador ? 9 : 8}" class="empty">No hay autos registrados todavía.</td></tr></c:if></tbody></table></div>
<div class="toolbar"><c:if test="${page > 1}"><a class="button ghost" href="${pageContext.request.contextPath}/autos?page=${page - 1}&amp;q=${search}&amp;sort=${sort}&amp;dir=${dir}">Anterior</a></c:if><c:if test="${page < totalPages}"><a class="button ghost" href="${pageContext.request.contextPath}/autos?page=${page + 1}&amp;q=${search}&amp;sort=${sort}&amp;dir=${dir}">Siguiente</a></c:if></div></main><script>(function(){const context='${pageContext.request.contextPath}',edit=document.getElementById('edit-action'),remove=document.getElementById('delete-action');document.querySelectorAll('input[name="selected-car"]').forEach(function(input){input.addEventListener('change',function(){const id=this.value;edit.href=context+'/autos?action=edit&id='+id;edit.classList.remove('disabled');edit.removeAttribute('aria-disabled');edit.removeAttribute('tabindex');remove.disabled=false;remove.onclick=function(){if(confirm('¿Eliminar este auto?')){window.location.href=context+'/autos?action=delete&id='+id;}};});});}());</script></body></html>
